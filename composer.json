{
  "name": "tassi/tassi-php",
  "description": "SDK PHP officiel pour l'API Tassi - Solution de logistique et d'expédition",
  "keywords": [
    "tassi",
    "shipping",
    "logistics",
    "api",
    "sdk"
  ],
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Tassi Team",
      "email": "dev@tassi.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "guzzlehttp/guzzle": "^7.0",
    "doctrine/inflector": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "mockery/mockery": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Tassi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tassi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage"
  }
}
