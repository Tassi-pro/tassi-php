{
    "name": "tassi/tassi-php",
    "description": "SDK PHP officiel pour l'API Tassi",
    "keywords": ["tassi", "shipping", "logistics", "api"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tassi Team",
            "email": "dev@tassi.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0",
        "doctrine/inflector": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Tassi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tassi\\Tests\\": "tests/"
        }
    }
}
