{
    "name": "tassi/tassi-php",
    "description": "Bibliothèque PHP officielle de l'API logistique Tassi",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Tassi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tassi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "authors": [
        {
            "name": "Dayane BAKARI",
            "email": "dayanetrunks@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.20"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^7.4"
    },
    "allow-plugins": {
    "php-http/discovery": false
}
}